# Server Configuration
NODE_ENV=development
PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_database_name

# Pricing Configuration
BASE_PRICE=1
PRICE_PER_USER=0.1
CURRENCY=USD

# PayHere Configuration
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=your_merchant_secret
FRONTEND_BASE_URL=http://localhost:3000
PAYHERE_NOTIFY_URL=your_public_notify_url
PAYHERE_RECURRENCE=1 Week
PAYHERE_RECURRING_DURATION=Forever

# Subscription Settings
SUBSCRIPTION_DURATION_DAYS=1

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
EMAIL_SECURE=true

# Default Customer Info for PayHere
PAYHERE_DEFAULT_PHONE=0771234567
PAYHERE_DEFAULT_ADDRESS=N/A
PAYHERE_DEFAULT_CITY=Colombo
PAYHERE_DEFAULT_COUNTRY=Sri Lanka
PAYHERE_SUBSCRIPTION_FLAG=1

# Application URLs & CORS
BACKEND_BASE_URL=http://localhost:5000
PAYHERE_CHECKOUT_URL=https://sandbox.payhere.lk/pay/checkout
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
INVOICE_STORAGE_DIR=./invoices